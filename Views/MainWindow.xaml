<Window x:Class="TechVendas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechVendas"
        mc:Ignorable="d"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}"
        
        Title="Tech Vendas" Height="600" Width="900" WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Dividimos a tela em duas linhas: Topo (Menu) e Resto (Conteúdo) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Linha 0: Ajusta ao tamanho do menu -->
            <RowDefinition Height="*"/>
            <!-- Linha 1: Ocupa todo o espaço restante -->
        </Grid.RowDefinitions>

        <!-- CABEÇALHO / MENU -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="10" 
                TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}">
            <Grid>
                <TextBlock Text="Tech Vendas" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Botão de Voltar -->
                    <Button Content="🡠 Voltar" Width="90" Margin="5,5,15,5" Background="Transparent" Foreground="White" BorderBrush="White" Click="BtnVoltar_Click"/>

                    <!-- Botão de Início -->
                    <Button Content="Início" Width="100" Margin="5" Background="Transparent" Foreground="White" BorderBrush="White" Click="BtnInicio_Click"/>
                    
                    <!-- Botão de Seleção de Aba -->
                    <Button Content="Client" Width="120" Margin="5" Foreground="White" BorderBrush="White" Click="BtnClients_Click"/>
                    <Button Content="Produtos" Width="120" Margin="5" Foreground="White" BorderBrush="White" Click="BtnProdutos_Click"/>
                    <Button Content="Pedidos" Width="120" Margin="5" Foreground="White" BorderBrush="White" Click="BtnPedidos_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ÁREA DE NAVEGAÇÃO -->
        <!-- É aqui dentro que as telas (UserControls) que fizemos antes vão aparecer -->
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>